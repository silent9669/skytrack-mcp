<?xml version="1.0"?>
<sdf version='1.9'>
  <world name="competition">
    <gui fullscreen='0'>
      <camera name='camera'>
        <pose>-16 0.2 5 0 0 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic' />
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Main ground plane for physics (invisible, large area) -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.8</restitution_coefficient>
              <threshold>0.05</threshold>
            </bounce>
            <contact>
              <ode>
                <min_depth>0.001</min_depth>
                <max_vel>10.0</max_vel>
                <kp>5e5</kp>
                <kd>200</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
      </link>
      <pose>10 0 0 0 0 0</pose>
    </model>

    <!-- Competition Area: Total 24m x 12m -->
    
    <model name="competition_area">
      <pose>22.3 5.98 0 0 0 3.14</pose>

      <!-- GREEN ZONE (Vehicle Zone): 4.5m x 12m - Left side -->
      <model name="zone_green">
        <static>true</static>
        <link name="link">
          <visual name="visual">
            <geometry>
              <box>
                <size>4.5 12 0.01</size>
              </box>
            </geometry>
            <material>
              <ambient>0.6 0.9 0.2 1</ambient>
              <diffuse>0.6 0.9 0.2 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
        </link>
        <pose>2.25 6 0.005 0 0 0</pose>
      </model>

      <!-- GRAY ZONE (Competition Area): 19.5m x 12m - Right side -->
      <model name="zone_gray">
        <static>true</static>
        <link name="link">
          <visual name="visual">
            <geometry>
              <box>
                <size>19.5 12 0.01</size>
              </box>
            </geometry>
            <material>
              <ambient>1 1 1 1</ambient>
              <diffuse>1 1 1 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
              <pbr>
                <metal>
                  <albedo_map>model://uav_contest_2026/materials/textures/Ground.png</albedo_map>
                  <metalness>0.0</metalness>
                  <roughness>0.9</roughness>
                </metal>
              </pbr>
            </material>
          </visual>
        </link>
        <pose>14.25 6 0.006 0 0 0</pose>
      </model>

      <!-- HELIPAD in Safe Zone -->
      <model name="helipad">
        <static>true</static>
        <link name="link">
          <visual name="visual">
            <geometry>
              <box>
                <size>1.5 1.5 0.01</size>
              </box>
            </geometry>
            <material>
              <ambient>1 1 1 1</ambient>
              <diffuse>1 1 1 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
              <pbr>
                <metal>
                  <albedo_map>model://uav_contest_2026/materials/textures/Heliport.png</albedo_map>
                  <metalness>0.0</metalness>
                  <roughness>0.8</roughness>
                </metal>
              </pbr>
            </material>
          </visual>
        </link>
        <pose>22.25 6 0.008 0 0 1.5708</pose>
      </model>

      <!-- SZ Marker (Green square) -->
      <model name="sz_marker">
        <static>true</static>
        <link name="link">
          <visual name="visual">
            <geometry>
              <box>
                <size>1.0 1.0 0.01</size>
              </box>
            </geometry>
            <material>
              <ambient>0.2 0.8 0.2 1</ambient>
              <diffuse>0.2 0.8 0.2 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
        </link>
        <pose>22.25 3.5 0.008 0 0 0</pose>
      </model>

      <!-- FIRE POINTS (F1-F5) - Center area -->
      <!-- F1: Red (main, right) -->
      <!-- F1: 1000mm Red Target #FC2A1B, height 6cm -->
      <model name="f1">
        <static>true</static>
        <link name="link">
          <!-- Black perimeter mat (slightly larger) -->
          <visual name="perimeter">
            <geometry>
              <cylinder>
                <radius>0.55</radius>
                <length>0.06</length>
              </cylinder>
            </geometry>
            <material>
              <ambient>0.05 0.05 0.05 1</ambient>
              <diffuse>0.05 0.05 0.05 1</diffuse>
              <specular>0.1 0.1 0.1 1</specular>
            </material>
          </visual>
          <!-- Red impact area (1000mm diameter) -->
          <visual name="target">
            <pose>0 0 0.001 0 0 0</pose>
            <geometry>
              <cylinder>
                <radius>0.5</radius>
                <length>0.06</length>
              </cylinder>
            </geometry>
            <material>
              <!-- #FC2A1B = RGB(252, 42, 27) = (0.988, 0.165, 0.106) -->
              <ambient>0.988 0.165 0.106 1</ambient>
              <diffuse>0.988 0.165 0.106 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
            </material>
          </visual>
          <!-- Collision for ball detection -->
          <collision name="target_collision">
            <pose>0 0 0.001 0 0 0</pose>
            <geometry>
              <cylinder>
                <radius>0.5</radius>
                <length>0.06</length>
              </cylinder>
            </geometry>
          </collision>
          <!-- Contact sensor to detect ball hits -->
          <sensor name="sensor_contact" type="contact">
            <always_on>true</always_on>
            <update_rate>1000</update_rate>
            <contact>
              <collision>target_collision</collision>
            </contact>
          </sensor>
        </link>
        <pose>13.5 6 0.03 0 0 0</pose>
      </model>

      <!-- F2: Red (main, left) -->
      <!-- F2: 1000mm Red Target #FC2A1B, height 6cm -->
      <model name="f2">
