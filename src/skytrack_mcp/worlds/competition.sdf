      <!-- TARGET ZONES (TZ1-TZ4) - Orange circles -->
      <!-- TZ1: Top right -->
      <!-- TZ1: Target Zone with 1.7m obstacle mesh -->
      <model name="tz1">
        <static>true</static>
        <link name="link">
          <!-- Base marker on ground -->
          <visual name="base_marker">
            <geometry>
              <cylinder>
                <radius>0.8</radius>
                <length>0.01</length>
